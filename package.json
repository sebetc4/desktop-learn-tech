{
    "name": "learn-tech",
    "version": "1.4.1",
    "description": "LearnTech helps you organize, track, and manage your technical courses with a beautiful, responsive interface and comprehensive progress tracking.",
    "main": "./out/main/index.js",
    "author": "sebetc4",
    "homepage": "https://github.com/sebetc4/app-learn-tech",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "lint:fix": "eslint --cache --fix .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "pnpm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "pnpm run build && electron-builder --dir",
        "build:win": "pnpm run build && electron-builder --win --publish never",
        "build:mac": "electron-vite build && electron-builder --mac --publish never",
        "build:linux": "electron-vite build && electron-builder --linux --publish never",
        "release:win": "pnpm run build && electron-builder --win --publish always",
        "release:mac": "electron-vite build && electron-builder --mac --publish always",
        "release:linux": "electron-vite build && electron-builder --linux --publish always",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:introspect": "drizzle-kit introspect",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@babel/plugin-transform-modules-commonjs": "^8.0.1",
        "@babel/standalone": "^8.0.10",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@hookform/resolvers": "^7.0.1",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@react-pdf-viewer/core": "^3.12.0",
        "@react-pdf-viewer/default-layout": "^3.12.0",
        "@react-pdf-viewer/full-screen": "^3.12.0",
        "@react-pdf-viewer/get-file": "^3.12.0",
        "@react-pdf-viewer/search": "^3.12.0",
        "@types/yauzl": "^3.4.0",
        "check-disk-space": "^4.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "electron-updater": "^6.8.11",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "lucide-react": "^1.66.0",
        "parse5": "^8.1.0",
        "pdfjs-dist": "3.11.174",
        "radix-ui": "^1.8.1",
        "react-hook-form": "^7.91.0",
        "react-router-dom": "^7.18.5",
        "react-syntax-highlighter": "^16.1.2",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "sql.js": "^1.15.2",
        "yauzl": "^3.4.0",
        "yup": "^1.7.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.1",
        "@electron-toolkit/eslint-config-ts": "^4.0.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/babel__standalone": "^7.1.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@types/sql.js": "^1.4.11",
        "@types/tar-stream": "^3.1.5",
        "@vitejs/plugin-react": "^6.1.2",
        "better-sqlite3": "^13.0.3",
        "drizzle-kit": "^0.31.11",
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sass": "^1.107.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    }
}
